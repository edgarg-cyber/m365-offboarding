inventory.csv
identity-audit-*.csv
identity-audit-*.html
response-*.html
signins-*.csv
offboarding-*.csv
onboarding-*.csv

# Real input files. Only the fake samples in sample-output/ belong in git.
new-hires.csv
!sample-output/
!sample-output/**

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# PowerShell and editors
*.ps1xml.bak
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db
